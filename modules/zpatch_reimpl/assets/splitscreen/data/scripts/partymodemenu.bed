local state
local tracks

local SplitScreen

local function DecodeSplitLayout(result)
	if type(result) == "number" and result == math.floor(result) and result >= 0 and result <= 3 then
		if result == 3 then
			return true,true
		elseif result == 2 then
			return false,true
		elseif result == 0 then
			return false,false
		end
	end

	-- A malformed result must never select geometry that native code has not
	-- positively reported as available.
	return false,false
end

local function QuerySplitLayout()
	-- Native returns bit 0 for active Vertical and bit 1 for capability. The
	-- binding is installed transactionally before this override is mounted.
	return DecodeSplitLayout(Input.GetSplitscreenLayoutState())
end

local function QuerySplitMaxPlayers()
	local result=Input.GetSplitscreenMaxPlayers()
	if type(result) == "number" and result == math.floor(result) and result >= 2 and result <= 4 then
		return result
	end
	return 2
end

local function ApplySplitLayout(vertical)
	local result
	if vertical then
		result=Input.SetSplitscreenLayoutVertical()
	else
		result=Input.SetSplitscreenLayoutHorizontal()
	end

	-- The native setter applies and persists synchronously, then returns the
	-- authoritative state. Fall back to the getter only for a malformed result.
	local active_vertical,vertical_capable=DecodeSplitLayout(result)
	if type(result) ~= "number" or result ~= math.floor(result) or result < 0 or result > 3 then
		active_vertical,vertical_capable=QuerySplitLayout()
	end
	if state then
		state.split_vertical=active_vertical
		state.split_vertical_capable=vertical_capable
	end
	return active_vertical
end

local function SplitLayoutLabel(vertical,capable)
	if not capable then
		return L"HORIZONTAL (VERTICAL UNAVAILABLE)"
	end
	if vertical then
		return L"VERTICAL (LEFT / RIGHT)"
	end
	return L"HORIZONTAL (TOP / BOTTOM)"
end

local function ResetSplitMenuControllers()
	if SplitScreen then
		GUI:ResetAllowedControllers()
	end
end

