function EnterPartyModeMenu(splitscreen,okaction,backaction)
	state = nil
	SplitScreen = splitscreen
	ResetSplitMenuControllers()
	OkAction = okaction
	BackAction = backaction
	EnterMenu("menu_partymode")
end

-- Needed when event selection is entered after a splitscreen race
function SetPlayerSetupParams(splitscreen,okaction,backaction)
	SplitScreen = splitscreen
	OkAction = okaction
	BackAction = backaction
end

menu_partymode = CreateMenuFromTemplate("template_basic")
menu_partymode.options.title=TRANSLATOR(TITLE_PARTYMODE)
menu_partymode.back = function()
	ResetSplitMenuControllers()
	if state then
		if state.input_player and state.input_layout_original ~= nil then
			state.split_vertical=state.input_layout_original
			ApplySplitLayout(state.split_vertical)
		end
		state.input_player=nil
		state.input_original=nil
		state.input_layout_original=nil
		state.input_device_count=nil
		state.input_armed=nil
		state.input_entering=nil
		state.removedplayer=nil
	end
	state=nil
	CupManager:Clear()
	if BackAction then
		BackAction()
	else
		EnterMenu("menu_multiplayer")
	end
end


local remove_player
local add_player
local go_race
local start_removeplayer
local start_splitinput
local EnterSplitCarSelection

local function SplitInputClaimed(input_index, playerindex)
	for i=1,state.num_players do
		if i ~= playerindex and state.players[i].input_index == input_index then
			return true
		end
	end
	return false
end

local function SplitInputOwner(input_index, playerindex)
	for i=1,state.num_players do
		if i ~= playerindex and state.players[i].input_index == input_index then
			return i
		end
	end
	return nil
end

local function FirstUnclaimedSplitInput(playerindex)
	local numcontrollers=Input.GetNumControllers()
	for input_index=0,numcontrollers-1 do
		if not SplitInputClaimed(input_index,playerindex) then
			return input_index
		end
	end
	return nil
end

local function SplitInputLabel(input_index)
	local numcontrollers=Input.GetNumControllers()
	if type(input_index) ~= "number" or input_index ~= math.floor(input_index) or input_index < 0 or input_index >= numcontrollers then
		return L"< NOT ASSIGNED >"
	end

	local label=ConvertToWString(string.format("%d: ",input_index+1))
	label=WStringConcat(label,Input.GetControllerName(input_index))
	return label
end

local function SplitInputSelectionError(input_index, playerindex)
	local numcontrollers=Input.GetNumControllers()
	if type(input_index) ~= "number" or input_index ~= math.floor(input_index) or input_index < 0 or input_index >= numcontrollers then
		return L(string.format("PLAYER %d DOES NOT HAVE A VALID INPUT DEVICE.\n\nRETURN TO PLAYER SETUP AND CHOOSE AN INPUT DEVICE.",playerindex))
	end

	for i=1,state.num_players do
		if i ~= playerindex and state.players[i].input_index == input_index then
			return L(string.format("PLAYER %d MUST USE A DIFFERENT INPUT DEVICE.\n\nCHOOSE AN UNCLAIMED DEVICE.",playerindex))
		end
	end

	return nil
end

local function SplitControllerLaunchError()
	local maxplayers=state.max_split_players or QuerySplitMaxPlayers()
	if state.num_players < 2 or state.num_players > maxplayers then
		if maxplayers >= 3 then
			return L(string.format("SPLIT SCREEN REQUIRES BETWEEN TWO AND %d PLAYERS.",maxplayers))
		end
		return L"SPLIT SCREEN REQUIRES EXACTLY TWO PLAYERS."
	end

	for i=1,state.num_players do
		local input_error=SplitInputSelectionError(state.players[i].input_index,i)
		if input_error then
			return input_error
		end
	end

	return nil
end

local function select_splitscreen_event()
	ResetSplitMenuControllers()
	local controller_error=SplitControllerLaunchError()
	if controller_error then
		MessageBox(controller_error,MESSAGEBOX_OK,function() GUI:ShowMenuButtons() end)
		return
	end
	ApplySplitLayout(state.num_players == 2 and state.split_vertical)

	OkAction(state)
end

local function select_party_events()


	EnterBuildPartyTournamentMenu(
		function(tournamentEvents)
			local cup = { Races={} }
			for i = 1, table.getn(tournamentEvents) do
				cup.Races[i] = {
					Level = tournamentEvents[i].trackid,
					Rules = GR_STUNT,
					EventType = Levels[tournamentEvents[i].trackid].StuntType,
					AIHandicapLevel = 1,
					AIUpgradeLevel = 1,
					StartPosition = 1,
				}
			end
			
			GameFlow.ClearRace()
			CupManager:PrepareFromScript(cup)
			
			for i=1,state.num_players do
				local playerinfo=db.GameFlow[string.format("PlayerInfo[%d]",i-1)]

				playerinfo.Name=state.players[i].name
				playerinfo.Car=state.players[i].car
				playerinfo.CarSkin=state.players[i].carskin or 1
				playerinfo.Controller=1 --//state.players[1].controller --//all use same controller as player 1
				playerinfo.Type=PLAYERTYPE_LOCAL
				playerinfo.CharType=0
			end

			db.GameFlow.PreRace.Mode=GM_PARTY
			db.GameFlow.PreRace.CupChoice=0
				
			Event:PostEvent(event(EVENT_RACE_BEGIN))

		end,
		function()
			CupManager:Clear()
			EnterMenu("menu_partymode_stuntselect")
		end
	)	

end


local function go_party_preset(x)
	local f=function()
		local x=x
		local preset=party_presets[x]

		local cup = { Races={} }
		for k,v in pairs(preset.events) do
			table.insert(cup.Races,{
				Level = v,
				Rules = GR_STUNT,
				EventType = Levels[v].StuntType,
				AIHandicapLevel = 1,
				AIUpgradeLevel = 1,
				StartPosition = 1,
			})
		end

		GameFlow.ClearRace()
		CupManager:PrepareFromScript(cup)

		for i=1,state.num_players do
			local playerinfo=db.GameFlow[string.format("PlayerInfo[%d]",i-1)]

			playerinfo.Name=state.players[i].name
			playerinfo.Car=state.players[i].car
			playerinfo.Controller=1 --//state.players[1].controller --//all use same controller as player 1
			playerinfo.CarSkin=state.players[i].carskin or 1
			playerinfo.Type=PLAYERTYPE_LOCAL
			playerinfo.CharType=0
		end

		db.GameFlow.PreRace.Mode=GM_PARTY
		db.GameFlow.PreRace.CupChoice=0
			
		Event:PostEvent(event(EVENT_RACE_BEGIN))
	end

	return f
end



local function set_buttons()
	menu_partymode.items={}

	local maxplayers = 8
	if SplitScreen then
		state.max_split_players=QuerySplitMaxPlayers()
		maxplayers = state.max_split_players
		local canrace=state.num_players >= 2 and state.num_players <= maxplayers
		menu_partymode.items[1]=MENUITEM(TRANSLATOR(ICON_PARTY_ADDPLAYER),state.num_players < maxplayers and add_player or disabled(),ICON(menu_partymode,state.num_players < maxplayers and "icon_add_player" or "icon_add_player_grayed"))
		menu_partymode.items[2]=MENUITEM(TRANSLATOR(ICON_PARTY_REMOVEPLAYER),state.num_players > 0 and start_removeplayer or disabled(),ICON(menu_partymode,state.num_players > 0 and "icon_remove_player" or "icon_remove_player_grayed"))
		menu_partymode.items[3]=MENUITEM(L"INPUT / LAYOUT",state.num_players >= 2 and start_splitinput or disabled(),ICON(menu_partymode,state.num_players >= 2 and "icon_add_player" or "icon_add_player_grayed"))
		menu_partymode.items[4]=MENUITEM(TRANSLATOR(ICON_SPLITSCREEN_GORACE),canrace and select_splitscreen_event or disabled(),ICON(menu_partymode,canrace and "icon_go_race" or "icon_go_race_grayed"))
		return
	end
	if state.num_players == 0 then
		menu_partymode.items[1]=MENUITEM(TRANSLATOR(ICON_PARTY_ADDPLAYER),add_player,ICON(menu_partymode,"icon_add_player"))
		menu_partymode.items[2]=MENUITEM(TRANSLATOR(ICON_PARTY_REMOVEPLAYER),disabled(),ICON(menu_partymode,"icon_remove_player_grayed"))
		menu_partymode.items[3]=MENUITEM(TRANSLATOR(ICON_PARTY_GORACE),disabled(),ICON(menu_partymode,"icon_go_race_grayed"))
	elseif state.num_players == maxplayers then
		if SplitScreen then
			menu_partymode.items[1]=MENUITEM(L"INPUT / LAYOUT",start_splitinput,ICON(menu_partymode,"icon_add_player"))
		else
			menu_partymode.items[1]=MENUITEM(TRANSLATOR(ICON_PARTY_ADDPLAYER),disabled(),ICON(menu_partymode,"icon_add_player_grayed"))
		end
		menu_partymode.items[2]=MENUITEM(TRANSLATOR(ICON_PARTY_REMOVEPLAYER),start_removeplayer,ICON(menu_partymode,"icon_remove_player"))
		if SplitScreen then
			menu_partymode.items[3]=MENUITEM(TRANSLATOR(ICON_SPLITSCREEN_GORACE),select_splitscreen_event,ICON(menu_partymode,"icon_go_race"))
		else
			menu_partymode.items[3]=MENUITEM(TRANSLATOR(ICON_PARTY_GORACE),entermenu("menu_partymode_stuntselect"),ICON(menu_partymode,"icon_go_race"))
		end
	else
		menu_partymode.items[1]=MENUITEM(TRANSLATOR(ICON_PARTY_ADDPLAYER),add_player,ICON(menu_partymode,"icon_add_player"))
		menu_partymode.items[2]=MENUITEM(TRANSLATOR(ICON_PARTY_REMOVEPLAYER),start_removeplayer,ICON(menu_partymode,"icon_remove_player"))
		if SplitScreen then
			if state.num_players == 2 then
				menu_partymode.items[3]=MENUITEM(TRANSLATOR(ICON_SPLITSCREEN_GORACE),select_splitscreen_event,ICON(menu_partymode,"icon_go_race"))
			else
				menu_partymode.items[3]=MENUITEM(TRANSLATOR(ICON_SPLITSCREEN_GORACE),disabled(),ICON(menu_partymode,"icon_go_race_grayed"))
			end
		else
			menu_partymode.items[3]=MENUITEM(TRANSLATOR(ICON_PARTY_GORACE),entermenu("menu_partymode_stuntselect"),ICON(menu_partymode,"icon_go_race"))
		end
	end

end

local function timer_buttons()
	set_buttons()
	GUI:InitMenuButtons(menu_partymode.items)
	if SplitScreen and state.num_players >= 2 and state.num_players <= state.max_split_players then
		GUI:SetActiveItem(4)
	else
		GUI:SetActiveItem(1)
	end
	GUI:ShowMenuButtons()
end


add_player = function()
	if SplitScreen and state.num_players >= (state.max_split_players or QuerySplitMaxPlayers()) then
		return
	end
	state.total_players = state.total_players + 1
	if state.total_players > 99 then
		state.total_players = 1
	end
	state.num_players = state.num_players + 1
	state.players[state.num_players]={}
	state.players[state.num_players].name=ConvertToWString(string.format("PLAYER%d",state.total_players))

	EnterMenu("menu_partymode_addplayer_name")

end


local function SetPlayerBars()
	local editing=SplitScreen and state.input_player ~= nil
	for i=1,8 do
		local prefix=string.format("player%d",i)

		if editing or i > state.num_players then
			W(prefix.."_bar"):SetAlpha(0)
			W(prefix.."_car"):SetAlpha(0)
			W(prefix.."_name"):SetAlpha(0)
		else
			local w=W(prefix.."_bar")
			w:SetAlpha(1)
			w:AttachResource(menu_partymode:getResource("black_transparent_50"))

			w=W(prefix.."_name")
			w:SetAlpha(1)
			w:SetTitle(state.players[i].name)

			w=W(prefix.."_car")
			w:SetAlpha(1)
			w:SetTitle(state.players[i].carname)
		end
	end

	if SplitScreen then
		W("party_name_header"):SetAlpha(editing and 0 or 1)
		W("party_car_header"):SetAlpha(editing and 0 or 1)
		W("split_setup_header"):SetAlpha(editing and 1 or 0)
		for i=1,4 do
			local prefix=string.format("player%d_input",i)
			if not editing or i > state.num_players then
				W(prefix.."_bar"):SetAlpha(0)
				W(prefix.."_label"):SetAlpha(0)
				W(prefix.."_value"):SetAlpha(0)
			else
				local w=W(prefix.."_bar")
				w:SetAlpha(1)
				w:AttachResource(menu_partymode:getResource("black_transparent_50"))
				W(prefix.."_label"):SetAlpha(1)
				w=W(prefix.."_value")
				w:SetAlpha(1)
				w:SetTitle(SplitInputLabel(state.players[i].input_index))
			end
			W(prefix.."_left"):HideWindow()
			W(prefix.."_right"):HideWindow()
		end
		local showlayout=editing and state.num_players >= 2
		local layoutbar=W("split_layout_bar")
		layoutbar:SetAlpha(showlayout and 1 or 0)
		if showlayout then layoutbar:AttachResource(menu_partymode:getResource("black_transparent_50")) end
		W("split_layout_label"):SetAlpha(showlayout and 1 or 0)
		local layoutvalue=W("split_layout_value")
		layoutvalue:SetAlpha(showlayout and 1 or 0)
		if state.num_players == 3 then
			layoutvalue:SetTitle(L"3-PLAYER GRID (ONE QUADRANT EMPTY)")
		elseif state.num_players == 4 then
			layoutvalue:SetTitle(L"4-PLAYER GRID")
		else
			layoutvalue:SetTitle(SplitLayoutLabel(state.split_vertical,state.split_vertical_capable))
		end
		W("split_layout_left"):HideWindow()
		W("split_layout_right"):HideWindow()
	end

end

local function splitinput_setselected()
	SetPlayerBars()
	local prefix
	if state.num_players == 2 and state.input_player == 3 then
		prefix="split_layout"
	else
		prefix=string.format("player%d_input",state.input_player)
	end
	local w=W(prefix.."_bar")
	w:AttachResource(menu_partymode:getResource("white_transparent"))
	w:SetAlpha(0.3)
	W(prefix.."_left"):ShowWindow()
	W(prefix.."_right"):ShowWindow()
end

local function end_splitinput(commit)
	if commit then
		SetPlayerBars()
		local numcontrollers=Input.GetNumControllers()
		if state.input_device_count ~= numcontrollers then
			state.input_device_count=numcontrollers
			splitinput_setselected()
			MessageBox(L"THE INPUT DEVICE LIST CHANGED. REVIEW BOTH ASSIGNMENTS, THEN CONFIRM AGAIN.",MESSAGEBOX_OK,function() W("inputhandler"):SetFocus() end)
			return false
		end
		local controller_error=SplitControllerLaunchError()
		if controller_error then
			MessageBox(controller_error,MESSAGEBOX_OK,function() W("inputhandler"):SetFocus() end)
			return false
		end
		ApplySplitLayout(state.num_players == 2 and state.split_vertical)
	elseif state.input_original then
		for i=1,state.num_players do
			state.players[i].input_index=state.input_original[i]
		end
		if state.input_layout_original ~= nil then
			state.split_vertical=state.input_layout_original
			ApplySplitLayout(state.split_vertical)
		end
	end
	state.input_player=nil
	state.input_original=nil
	state.input_layout_original=nil
	state.input_device_count=nil
	state.input_armed=nil
	state.input_entering=nil
	SetPlayerBars()
	-- Editing never changes the live party actions. Reuse the existing
	-- ButtonBar instead of rebuilding it from inside an input callback.
	if commit then
		GUI:SetActiveItem(4)
	else
		GUI:SetActiveItem(3)
	end
	GUI:ShowMenuButtons()
	GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
	ResetSplitMenuControllers()
	return true
end

local function cycle_splitinput(direction)
	local playerindex=state.input_player
	if not playerindex then
		return
	end
	if state.num_players == 2 and playerindex == 3 then
		if not state.split_vertical_capable then
			return false
		end
		state.split_vertical=not state.split_vertical
		ApplySplitLayout(state.split_vertical)
		splitinput_setselected()
		return true
	end

	local numcontrollers=Input.GetNumControllers()
	if numcontrollers < 1 then
		return
	end

	local current=state.players[playerindex].input_index
	if type(current) ~= "number" or current ~= math.floor(current) or current < 0 or current >= numcontrollers then
		current=0
	end

	for step=1,numcontrollers do
		local candidate=math.mod(current+direction*step,numcontrollers)
		if candidate < 0 then
			candidate=candidate+numcontrollers
		end
		if candidate == state.players[playerindex].input_index then
			return false
		end

		local owner=SplitInputOwner(candidate,playerindex)
		if owner then
			local previous=state.players[playerindex].input_index
			if type(previous) == "number" and previous == math.floor(previous) and previous >= 0 and previous < numcontrollers then
				state.players[owner].input_index=previous
				state.players[playerindex].input_index=candidate
				splitinput_setselected()
				return true
			end
		else
			state.players[playerindex].input_index=candidate
			splitinput_setselected()
			return true
		end
	end
	return false
end

start_splitinput = function()
	if state.input_entering or state.input_player then
		return
	end
	state.max_split_players=QuerySplitMaxPlayers()
	if state.num_players < 2 or state.num_players > state.max_split_players then
		MessageBox(L"ADD A SUPPORTED NUMBER OF PLAYERS BEFORE CHOOSING INPUT DEVICES.",MESSAGEBOX_OK,function() GUI:ShowMenuButtons() end)
		return
	end

	state.input_entering=true
	GUI:HideMenuButtons()
	state.input_player=1
	state.input_original={}
	for i=1,state.num_players do
		state.input_original[i]=state.players[i].input_index
	end
	state.input_layout_original=state.split_vertical
	state.input_device_count=Input.GetNumControllers()
	-- A controller confirmation may arrive both natively and as Zoom's
	-- synthesized Return. Arm on a later timer tick so neither copy can be
	-- interpreted as an edit/commit action after focus changes.
	state.input_armed=nil
	splitinput_setselected()
	W("inputhandler"):SetFocus()
	GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
	state.input_entering=nil
	Event:AddTimer(function()
		if state and state.input_player then
			state.input_armed=true
		end
	end,0.4,nil,TRUE)
end


local function end_removeplayer()
	state.removedplayer=nil
	SetPlayerBars()
	GUI:SetActiveItem(2)
	GUI:ShowMenuButtons()

end



remove_player = function()
	ResetSplitMenuControllers()

--//	table.remove(state.players,state.removedplayer)
	for i=state.removedplayer,state.num_players do
		state.players[i]=state.players[i+1]
	end
	state.players[state.num_players]=nil

	state.removedplayer=nil

	state.num_players = state.num_players - 1

	SetPlayerBars()

	set_buttons()
	GUI:InitMenuButtons(menu_partymode.items)
	GUI:SetActiveItem(1)
	GUI:ShowMenuButtons()




	
end

local function remove_setselected()
	local prefix=string.format("player%d",state.removedplayer)

	SetPlayerBars()
	local w=W(prefix.."_bar")
	w:AttachResource(menu_partymode:getResource("white_transparent"))
	w:SetAlpha(0.3)

end


start_removeplayer = function()
	GUI:HideMenuButtons()
	state.removedplayer=state.num_players
	SetPlayerBars()
	remove_setselected()

	W("inputhandler"):SetFocus()
end



go_race = function()
	GameFlow.ClearRace()

	for i=1,state.num_players do
		local playerinfo=db.GameFlow[string.format("PlayerInfo[%d]",i-1)]

		playerinfo.Name=state.players[i].name
		playerinfo.Car=state.players[i].car
		playerinfo.CarSkin=state.players[i].carskin or 1
		playerinfo.Type=PLAYERTYPE_LOCAL
		playerinfo.CharType=0

		db.GameFlow.PreRace.Mode=GM_PARTY
		db.GameFlow.PreRace.Level=state.selected_stunt or 72
		
		Event:PostEvent(event(EVENT_RACE_BEGIN))
	end
end




function menu_partymode.create(self)
	self.parent:create(self)

	self:addResource("profile_elements.tga",profile_elements,profile_elements_size)

	if not state then
		state={}
		state.total_players= 0
		state.num_players= 0
		state.players={}
		if SplitScreen then
			state.max_split_players=QuerySplitMaxPlayers()
			state.split_vertical,state.split_vertical_capable=QuerySplitLayout()
		end

		for i=1,8 do
			local playerinfo=db.GameFlow[string.format("PlayerInfo[%d]",i-1)]

			if playerinfo.Type == PLAYERTYPE_LOCAL and (not SplitScreen or state.num_players < state.max_split_players) then
				local playerindex=state.num_players+1
				state.players[playerindex]={}
				state.players[playerindex].name=playerinfo.Name
				state.players[playerindex].car=playerinfo.Car
				state.players[playerindex].carskin=playerinfo.CarSkin
				if SplitScreen then
					state.players[playerindex].input_index=playerinfo.Controller
				end
				
				local cardata=db.FlatOut2.Cars:GetProperty("Car",state.players[playerindex].car)
				state.players[playerindex].carname=ConvertToWString(cardata.Name)


				state.num_players = state.num_players + 1
				state.total_players = state.total_players + 1
			end
		end
	end
	GameFlow.ClearRace()


	if SplitScreen then
		menu_partymode.options.title=TRANSLATOR(ICON_MULTIPLAYER_SPLITSCREEN)
	else
		menu_partymode.options.title=TRANSLATOR(TITLE_PARTYMODE)
	end

	--state=state or {}
	--state.total_players=state.total_players or 0
	--state.num_players=state.num_players or 0
	--state.players = state.players or {}

	self:loadResources()


	set_buttons()


end




function menu_partymode.init(self)
	-- Party setup and the following track picker are shared menus. Restore the
	-- stock any-device mask whenever this screen is entered.
	ResetSplitMenuControllers()
	self.parent:init(self)

	GUI:SetBackgroundVideo("data/video/bg_main")

	Frame{Position=POS(0,78),Size=SIZE(279,24)}:AttachResource(self:getResource("party_mode_title_bar"))
	StaticText{Title=TRANSLATOR(TITLE_PLAYERSETUP),Color=GetPaletteColor(33),Position=POS(268,80),Align=FONTF_RIGHT,Font=fontlarge()}


	StaticText{Name="party_name_header",Title=TRANSLATOR(TITLE_NAME),Font=fontsmall(),Position=POS(278,110),Color=GetPaletteColor(33),Align=FONTF_RIGHT}
	StaticText{Name="party_car_header",Title=TRANSLATOR(TITLE_CAR),Font=fontsmall(),Position=POS(293,110),Color=GetPaletteColor(33)}

	local pos=POS(290,131)

	for i=1,8 do
		local prefix=string.format("player%d",i)
		Frame{Name=prefix.."_bar",Position=POS(0,pos[2]),Size=SIZE(640,20)}:AttachResource(self:getResource("black_transparent_50"))
		StaticText{Name=prefix.."_name",Position=POS(pos[1]-9,pos[2]),Font=fontsmall(),Color=GetPaletteColor(34),Align=FONTF_RIGHT}
		StaticText{Name=prefix.."_car",Position=POS(pos[1]+9,pos[2]),Font=fontsmall(),Color=GetPaletteColor(34)}
		pos[1] = pos[1] + 8
		pos[2] = pos[2] + 26
	end

	if SplitScreen then
		StaticText{Name="split_setup_header",Title=L"SPLIT SETUP",Font=fontsmall(),Position=POS(278,110),Color=GetPaletteColor(33),Align=FONTF_RIGHT}
		local inputarrowsize=GetResourceSize(self:getResource("selection_arrow_l"))
		local inputy=131
		for i=1,4 do
			local prefix=string.format("player%d_input",i)
			Frame{Name=prefix.."_bar",Position=POS(0,inputy),Size=SIZE(640,20)}:AttachResource(self:getResource("black_transparent_50"))
			StaticText{Name=prefix.."_label",Title=ConvertToWString(string.format("PLAYER %d",i)),Position=POS(278,inputy),Font=fontsmall(),Color=GetPaletteColor(34),Align=FONTF_RIGHT}
			Frame{Name=prefix.."_left",Position=POS(298,inputy+5),Size=inputarrowsize}:AttachResource(self:getResource("selection_arrow_r"))
			StaticText{Name=prefix.."_value",Position=POS(314,inputy),Size=SIZE(286,20),Font=fontsmall(),Color=GetPaletteColor(34)}
			Frame{Name=prefix.."_right",Position=POS(604,inputy+5),Size=inputarrowsize}:AttachResource(self:getResource("selection_arrow_l"))
			inputy=inputy+26
		end
		Frame{Name="split_layout_bar",Position=POS(0,inputy),Size=SIZE(640,20)}:AttachResource(self:getResource("black_transparent_50"))
		StaticText{Name="split_layout_label",Title=L"SPLIT LAYOUT",Position=POS(278,inputy),Font=fontsmall(),Color=GetPaletteColor(34),Align=FONTF_RIGHT}
		Frame{Name="split_layout_left",Position=POS(298,inputy+5),Size=inputarrowsize}:AttachResource(self:getResource("selection_arrow_r"))
		StaticText{Name="split_layout_value",Position=POS(314,inputy),Size=SIZE(286,20),Font=fontsmall(),Color=GetPaletteColor(34)}
		Frame{Name="split_layout_right",Position=POS(604,inputy+5),Size=inputarrowsize}:AttachResource(self:getResource("selection_arrow_l"))
	end

	SetPlayerBars()


	local input=InputHandler{Name="inputhandler"}


	input.onKeyPressed = function(self,character,virtualkey,scancode)
		if state.input_player then
			if not state.input_armed then
				return
			elseif virtualkey == KeyCodes.BUTTON_UP then
				if state.input_player > 1 then
					state.input_player=state.input_player-1
					splitinput_setselected()
				end
				playmenusound_move()
			elseif virtualkey == KeyCodes.BUTTON_DOWN then
				local lastrow=state.num_players
				if state.num_players == 2 then lastrow=lastrow+1 end
				if state.input_player < lastrow then
					state.input_player=state.input_player+1
					splitinput_setselected()
				end
				playmenusound_move()
			elseif virtualkey == KeyCodes.BUTTON_LEFT then
				if cycle_splitinput(-1) then
					playmenusound_move()
				end
			elseif virtualkey == KeyCodes.BUTTON_RIGHT then
				if cycle_splitinput(1) then
					playmenusound_move()
				end
			elseif virtualkey == KeyCodes.BUTTON_SELECT then
				if end_splitinput(false) then
					playmenusound_back()
				end
			elseif virtualkey == KeyCodes.BUTTON_START then
				if end_splitinput(true) then
					playmenusound_action()
				end
			end
		elseif state.removedplayer and virtualkey == KeyCodes.BUTTON_UP then
			if state.removedplayer > 1 then
				state.removedplayer = state.removedplayer - 1 
				remove_setselected()
			end
			playmenusound_move()
		elseif state.removedplayer and virtualkey == KeyCodes.BUTTON_DOWN then
			if state.removedplayer < state.num_players then
				state.removedplayer = state.removedplayer + 1 
				remove_setselected()
			end
			playmenusound_move()
		elseif state.removedplayer and virtualkey == KeyCodes.BUTTON_SELECT then
			end_removeplayer()
			playmenusound_back()
		elseif state.removedplayer and virtualkey == KeyCodes.BUTTON_START then
			remove_player()
			playmenusound_action()
		end

	end




	--//GUI:SetBackground("data/menu/canvas_bg.tga")
	GUI:SetBackgroundVideo("data/video/bg_main")
	GUI:SetHelpButtons(BUTTON_OK,TRANSLATOR(UI_SELECT),BUTTON_BACK,TRANSLATOR(UI_BACK))
	if SplitScreen and state.num_players >= 2 and state.num_players <= state.max_split_players then
		GUI:SetActiveItem(4)
	end

end


function menu_partymode.deinit(self)
	if state then
		if state.input_player and state.input_original then
			for i=1,state.num_players do
				state.players[i].input_index=state.input_original[i]
			end
			if state.input_layout_original ~= nil then
				state.split_vertical=state.input_layout_original
				ApplySplitLayout(state.split_vertical)
			end
		end
		state.input_player=nil
		state.input_original=nil
		state.input_layout_original=nil
		state.input_device_count=nil
		state.input_armed=nil
		state.input_entering=nil
		state.removedplayer=nil
	end
	self.parent:deinit(self)

end



